# Supabase project (same project as the legacy app, until data migration is
# complete — do NOT create a second Supabase project for this).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Full RLS bypass — only for the narrow set of admin
# operations that explicitly need it. Never expose to the client, never use
# as the default query path (that was the legacy app's mistake).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for drizzle-kit (Project Settings ->
# Database -> Connection string -> URI). Use the pooler (port 6543,
# ?pgbouncer=true) for the app at runtime and the direct connection
# (port 5432) for drizzle-kit generate/push.
DATABASE_URL=

# --- Phase 2+ (not yet wired to any code path) ---
# E-signature vendor (DocuSign or Dropbox Sign - TBD, see plan doc)
# ESIGN_PROVIDER_API_KEY=

# Payroll provider (Gusto/Check/ADP - TBD, see plan doc)
# PAYROLL_PROVIDER_API_KEY=

# DHS E-Verify Web Services (requires employer/employer-agent enrollment
# first - see plan doc, this is a legal/business step, not just a key)
# EVERIFY_API_KEY=

# Anthropic Claude API - document intelligence, compliance assistant
# ANTHROPIC_API_KEY=
