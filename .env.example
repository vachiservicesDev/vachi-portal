# This is a fresh, standalone Supabase project for Vachi Portal — free
# tier is enough for development (Auth + Postgres + Storage + Realtime all
# included). Create one at supabase.com if you don't have one yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Full RLS bypass — only for the narrow set of admin
# operations that explicitly need it (writing generated onboarding
# documents into private Storage, admin user provisioning). Never expose
# to the client, never use as the default query path.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for drizzle-kit (Project Settings ->
# Database -> Connection string -> URI). Use the pooler (port 6543,
# ?pgbouncer=true) for the app at runtime and the direct connection
# (port 5432) for drizzle-kit generate/push.
DATABASE_URL=

# Public URL this app is reachable at — used to build the webhook URL
# handed to the e-signature vendor. For local dev, use an https tunnel
# (e.g. `npx ngrok http 3000`) since Dropbox Sign needs to reach it over
# the internet to deliver webhook events; http://localhost won't work.
NEXT_PUBLIC_APP_URL=

# --- Phase 2: Onboarding / e-signature ---
# Free developer/sandbox account at dropboxsign.com — no payment needed.
# Sandbox requests (test_mode=true) don't count against any paid quota and
# aren't legally binding, which is exactly what local/dev testing needs.
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEST_MODE=true

# --- Phase 5: Payroll provider (Gusto/Check/ADP - vendor TBD, see docs/PLAN.md) ---
# PAYROLL_PROVIDER_API_KEY=

# --- Phase 3: DHS E-Verify Web Services ---
# Requires employer/employer-agent enrollment first - see docs/PLAN.md,
# this is a legal/business step, not just a key.
# EVERIFY_API_KEY=

# --- AI features: Claude API (document intelligence, compliance assistant) ---
# Pay-as-you-go, no subscription required.
# ANTHROPIC_API_KEY=
